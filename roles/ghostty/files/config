# ---- Font ----
font-family = Operator Mono Lig
font-size = 13.5
font-thicken = true
font-feature = calt
font-feature = liga

# ---- Theme ----
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# ---- Shell ----
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ---- Window ----
window-save-state = always
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-decoration = true
macos-titlebar-style = tabs
macos-option-as-alt = true

# ---- Appearance ----
background-opacity = 0.92
background-blur = true
cursor-style = bar
cursor-style-blink = true
cursor-color = #89b4fa
mouse-hide-while-typing = true

# ---- Behavior ----
copy-on-select = false
scrollback-limit = 100000
confirm-close-surface = false
focus-follows-mouse = true
clipboard-trim-trailing-spaces = true
quit-after-last-window-closed = false

# ---- Keybinds ----
keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = cmd+n=new_window
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+r=reload_config
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom
keybind = cmd+shift+equal=resize_split:up,10
keybind = cmd+shift+minus=resize_split:down,10
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5
